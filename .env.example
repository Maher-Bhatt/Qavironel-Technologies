# =============================================================================
# QAVIRONEL TECHNOLOGIES — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development.
# Configure corresponding environment variables in your deployment platform (e.g. Vercel, Netlify).
# NEVER commit real API keys or secrets to version control.
# =============================================================================

# --- CLIENT-SIDE VARIABLES (Vite bundle) ---
# Canonical website production origin
VITE_SITE_URL=https://qavironel.com

# Form and booking submission endpoints
# In local development with Vite dev server alone (without serverless functions),
# the client safely triggers honest fallbacks (direct mailto / WhatsApp) if the backend returns 404/503.
VITE_CONTACT_ENDPOINT=/api/contact
VITE_BOOKING_ENDPOINT=/api/booking
VITE_QUOTE_ENDPOINT=/api/quote

# --- SERVERLESS FUNCTION VARIABLES (Vercel / Node server runtime only) ---
# Secrets must NEVER be prefixed with VITE_ to prevent leakage into client JavaScript.

# Resend API Key for verified email delivery
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender email address configured in Resend
# Default sandbox for initial testing before purchasing a custom domain:
RESEND_FROM_EMAIL=onboarding@resend.dev
# (Once you purchase and verify your domain in Resend later, switch to e.g. notifications@qavironel.com)

# Business inbox that receives contact inquiries and booking requests
# Note: In Resend sandbox mode, this must be the email address of your Resend account (e.g. maherbhatt01@gmail.com).
CONTACT_RECEIVER_EMAIL=maherbhatt01@gmail.com
